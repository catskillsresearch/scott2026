universe u

namespace Scott2026

variable {A : Type u}
namespace D0Formula

/-- `Fin.cons` on names, with a constant motive so both sides stay `AName`. -/
def consName {n : ℕ} (x : AName.{u} A) (ρ : Fin n → AName.{u} A) :
    Fin (n + 1) → AName.{u} A :=
  Fin.cons (α := fun _ : Fin (n + 1) => AName.{u} A) x ρ


end D0Formula

end Scott2026
